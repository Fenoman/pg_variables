(1 row)

ROLLBACK TO later_inner;
DO $$ BEGIN
 IF pgv_get('reuse_release', 'tx', NULL::integer, false) IS DISTINCT FROM 22 THEN
  RAISE EXCEPTION 'released removal contaminated a later rollback';
 END IF;
END $$;
