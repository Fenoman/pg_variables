(1 row)

SELECT pgv_set('ip_fixed', 'uuid_value', NULL::uuid);
 pgv_set 
---------
 
(1 row)

SELECT pgv_get('ip_fixed', 'uuid_value', NULL::uuid, false) AS uuid_null;
