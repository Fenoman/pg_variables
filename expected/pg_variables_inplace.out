 pgv_set 
---------
 
(1 row)

SELECT pgv_set('ip_fixed', 'tid_value', '(3,4)'::tid);
 pgv_set 
---------
 
(1 row)

SELECT pgv_get('ip_fixed', 'tid_value', NULL::tid) AS tid_value;
 tid_value 
-----------
