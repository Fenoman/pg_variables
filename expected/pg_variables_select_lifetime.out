DO $$
DECLARE
    rem integer := 0;
    pkg text;
    c refcursor := 'stats_snap_cur';
BEGIN
    LOOP
        FETCH c INTO pkg;
        EXIT WHEN NOT FOUND;
        rem := rem + 1;
    END LOOP;
    IF rem <> 2 THEN
        RAISE EXCEPTION 'pgv_remove discarded % materialized stats rows', 2 - rem;
