    c refcursor := 'stats_empty_cur';
BEGIN
    FETCH c INTO pkg;
    IF FOUND THEN
        RAISE EXCEPTION 'empty-hash rollback left unread stats row: %', pkg;
    END IF;
END
$$;
CLOSE stats_empty_cur;
