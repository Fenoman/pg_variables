 pgv_insert 
------------
 
(1 row)

SELECT pgv_insert('lifetime', 'rec', ROW (2::int, 'two'::text));
 pgv_insert 
------------
 
(1 row)

BEGIN;
DECLARE array_cur CURSOR FOR SELECT pgv_select('lifetime', 'rec', ARRAY[1, 2]);
FETCH 1 FROM array_cur;
 pgv_select 
------------
 (1,one)
(1 row)

SELECT pgv_free();
 pgv_free 
----------
 
(1 row)

FETCH ALL FROM array_cur;
 pgv_select 
------------
(0 rows)

COMMIT;
SELECT pgv_free();
 pgv_free 
----------
 
(1 row)

