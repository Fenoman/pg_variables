DO $$
BEGIN
	FOR i IN 1..25 LOOP
		PERFORM pgv_insert('test', 'x', row (i, i * 10), false);
	END LOOP;
END $$;
CREATE FUNCTION pgv_atx_set(n int) RETURNS void AS $$
BEGIN AUTONOMOUS
	PERFORM pgv_set('vars', 'n', n);
END;
$$ LANGUAGE plpgsql;
ERROR:  syntax error at or near "AUTONOMOUS"
LINE 2: BEGIN AUTONOMOUS
              ^
CREATE FUNCTION pgv_atx_count(c refcursor) RETURNS int AS $$
DECLARE
	r			record;
	n			int := 0;
BEGIN
	LOOP
		FETCH c INTO r;
		EXIT WHEN NOT FOUND;
		n := n + 1;
	END LOOP;
	RETURN n;
END;
$$ LANGUAGE plpgsql;
-- NOTICE:  rows: 25, 25
DO $$
DECLARE
	r			record;
	n_block		int := 0;
	n_function	int := 0;
BEGIN
	FOR r IN SELECT pgv_select('test', 'x') LOOP
		n_block := n_block + 1;
		BEGIN AUTONOMOUS
			PERFORM pgv_set('vars', 'n', n_block);
		END;
	END LOOP;
	FOR r IN SELECT pgv_select('test', 'x') LOOP
		n_function := n_function + 1;
		PERFORM pgv_atx_set(n_function);
	END LOOP;
	RAISE NOTICE 'rows: %, %', n_block, n_function;
END $$;
